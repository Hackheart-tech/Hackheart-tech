 <!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bannière HackHeart</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap">
<style>
  :root{
    --ground:#f7f9f8; --panel:#ffffff; --ink:#0f1720; --muted:#64748b;
    --line:#e2e8f0; --deep:#0d422c; --green:#1a8a54; --bright:#3ddc84; --mint:#8ce6af;
    --grid:rgba(26,138,84,.10);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme=light]){
      --ground:#080d0b; --panel:#0d1512; --ink:#eef7f2; --muted:#8ea79b;
      --line:#1c2b24; --grid:rgba(61,220,132,.10);
    }
  }
  :root[data-theme=dark]{
    --ground:#080d0b; --panel:#0d1512; --ink:#eef7f2; --muted:#8ea79b;
    --line:#1c2b24; --grid:rgba(61,220,132,.10);
  }
  *{box-sizing:border-box}
  body{background:var(--ground);color:var(--ink);
    font-family:"Poppins",system-ui,sans-serif;
    display:flex;align-items:center;justify-content:center;
    min-height:100vh;margin:0;padding:32px;}
  .wrap{width:100%;max-width:1100px}
  .banner{
    position:relative;overflow:hidden;
    background:var(--panel);
    border:1px solid var(--line);border-radius:18px;
    display:grid;grid-template-columns:auto 1fr;
    box-shadow:0 18px 50px -24px rgba(13,66,44,.45);
    background-image:
      linear-gradient(var(--grid) 1px,transparent 1px),
      linear-gradient(90deg,var(--grid) 1px,transparent 1px);
    background-size:26px 26px;background-position:center;
  }
  .banner::before,.banner::after{content:"";position:absolute;left:0;right:0;height:5px;
    background:linear-gradient(90deg,var(--deep),var(--bright),var(--mint));}
  .banner::before{top:0}
  .banner::after{bottom:0;background:linear-gradient(90deg,var(--mint),var(--bright),var(--deep))}
  .logo{display:flex;align-items:center;justify-content:center;padding:34px 40px;}
  .logo img{width:190px;height:auto;display:block;
    filter:drop-shadow(0 6px 16px rgba(26,138,84,.25));}
  .divider{width:1px;background:linear-gradient(var(--line),transparent 12%,var(--line) 50%,transparent 88%,var(--line));}
  .content{padding:44px 52px 40px 48px;display:flex;flex-direction:column;justify-content:center;gap:14px;}
  h1{margin:0;font-weight:700;font-size:clamp(34px,5vw,60px);line-height:1.02;letter-spacing:-.02em;
    background:linear-gradient(92deg,var(--deep),var(--green) 42%,var(--bright));
    -webkit-background-clip:text;background-clip:text;color:transparent;}
  .sub{margin:0;font-weight:500;font-size:clamp(15px,2vw,24px);color:var(--ink);}
  .sub .dot{color:var(--bright);padding:0 6px;}
  .creds{display:flex;align-items:center;gap:12px;margin-top:6px;
    font-family:ui-monospace,"SF Mono",Menlo,monospace;
    font-size:clamp(12px,1.4vw,16px);color:var(--muted);letter-spacing:.01em;flex-wrap:wrap;}
  .creds .bul{width:11px;height:11px;border-radius:50%;background:var(--bright);flex:none;
    box-shadow:0 0 0 4px rgba(61,220,132,.18);}
  @media (max-width:640px){
    .banner{grid-template-columns:1fr}
    .divider{display:none}
    .logo{padding:28px 0 4px}
    .content{padding:14px 30px 34px;text-align:center;align-items:center}
    .creds{justify-content:center}
  }
</style>
</head>
<body>
  <div class="wrap">
    <div class="banner">
      <div class="logo"><img alt="HackHeart" src="logo.png"></div>
      <div class="divider"></div>
      <div class="content">
        <h1>Sécurité offensive</h1>
        <p class="sub">Pentest <span class="dot">·</span> Red Team <span class="dot">·</span> Audit d'infrastructure</p>
        <div class="creds"><span class="bul"></span> CPTS · CRTA · RNCP 37680 &nbsp;//&nbsp; ~60 missions livrées</div>
      </div>
    </div>
  </div>
</body>
</html>
